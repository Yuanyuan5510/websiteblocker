{
  "name": "website-blocker-launcher",
  "version": "1.1.0",
  "description": "Website Blocker Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:x86": "electron-builder --ia32",
    "build:x64": "electron-builder --x64"
  },
  "keywords": [
    "electron",
    "website-blocker",
    "launcher"
  ],
  "author": "wang.station",
  "license": "GPL-3.0-only",
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-windows": "^1.0.0-beta.8",
    "ps-list": "^8.1.1",
    "sudo-prompt": "^9.2.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "wang.station.websiteblocker",
    "productName": "WebsiteBlocker Setup",
    "copyright": "Copyright © 2026 wang.station",
    "directories": {
      "output": "../32bit"
    },
    "files": [
      "index.html",
      "main.js",
      "style.css",
      "script.js",
      "icon.png",
      "icon.ico",
      "package.json",
      ".icon-ico/**/*"
    ],
    "extraFiles": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "backend/",
        "to": "backend/",
        "filter": ["**/*"]
      },
      {
        "from": "browser/",
        "to": "browser/",
        "filter": ["**/*"]
      },
      {
        "from": "frontend/",
        "to": "frontend/",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "certificateFile": "I:\\MongoDB-start\\wang.station.pfx",
        "certificatePassword": "654800",
        "publisherName": "wang.station",
        "signingHashAlgorithms": ["sha256"]
      },
      "fileAssociations": []
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "publish": {
      "provider": "generic",
      "url": "websiteblocker.wangstation.dpdns.org"
    },
    "extraMetadata": {
      "publisher": "wang.station",
      "owner": "wang.station",
      "supportEmail": "wang.station@hotmail.com",
      "supportUrl": "websiteblocker.wangstation.dpdns.org"
    }
  }
}
