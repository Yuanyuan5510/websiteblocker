{
  "name": "WebsiteBlockerFrontend",
  "private": true,
  "version": "1.1.0",
  "type": "commonjs",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "dev": "vite --port 16410",
    "build": "tsc && vite build",
    "preview": "vite preview --port 16410",
    "pkg-build": "pkg . -t node18-win-x64 --debug",
    "pkg-build-x86": "pkg . -t node18-win-x86 --output ./dist-exe/WebsiteBlockerFrontend-x86.exe",
    "pkg-build-x64": "pkg . -t node18-win-x64 --output ./dist-exe/WebsiteBlockerFrontend-x64.exe",
    "nexe-build-x86": "nexe -i server.js -o ./dist-exe/WebsiteBlockerFrontend-x86.exe -t windows-x86-14.15.0"
  },
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "./dist-exe",
    "assets": [
      "dist/**/*",
      "node_modules/http-proxy/**/*"
    ],
    "name": "wang.station.websiteblocker",
    "description": "Website Blocker Frontend Service",
    "productName": "Website Blocker",
    "companyName": "yuanyuan5510/wang.station",
    "copyright": "Copyright (c) 2025-2026 yuanyuan5510/wang.station",
    "version": "4.5",
    "license": "MIT",
    "exclude": [
      "browser/**/*",
      ".git/**/*",
      "node_modules/**/.cache/**/*",
      "test/**/*",
      "tests/**/*",
      "*.md",
      ".*"
    ],
    "icon": "../browser/app_icon.png",
    "console": false,
    "output": "websiteblocker-no-console.exe",
    "options": {
      "strip": true,
      "upx": true
    }
  },
  "publisherName": "yuanyuan5510/wang.station",
  "author": "yuanyuan5510/wang.station",
  "copyright": "Copyright (c) 2025-2026 yuanyuan5510/wang.station",
  "supportEmail": "wang.station@hotmail.com",
  "supportUrl": "websiteblocker.wangstation.dpdns.org",
  "devDependencies": {
    "nexe": "^5.0.0-beta.4",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "dependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "axios": "^1.13.2",
    "http-proxy": "^1.18.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0"
  }
}
